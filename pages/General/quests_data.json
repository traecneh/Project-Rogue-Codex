  "quests": [
    {
      "id": "welcome-to-silvest",
      "name": "Welcome to Silvest",
      "category": "Tutorial",
      "region": "Silvest",
      "area": "Silvest Town - outside the starting building",
      "min_level": 1,
      "repeatable": false,
      "giver": {
        "name": "Town Guide",
        "coordinates": [3415, 3722],
        "markers": "!?*"
      },
      "prerequisites": [],
      "initial_dialogue": "Welcome to Silvest! You can press \"F1\" to get your bearings. Let me also give you some directions of places to go!",
      "stages": [
        {
          "number": 1,
          "label": "Town orientation",
          "objectives": [
            {
              "number": 1,
              "text": "Check out the Bank!",
              "target": {
                "kind": "location",
                "label": "Silvest Bank",
                "coordinates": [3468, 3729]
              }
            },
            {
              "number": 2,
              "text": "Check out the Potion Shop!",
              "target": {
                "kind": "location",
                "label": "Potion Shop",
                "coordinates": [3458, 3740]
              }
            }
          ]
        },
        {
          "number": 2,
          "label": "Southern outpost",
          "unlocks_after": "Complete objectives 1 and 2",
          "objectives": [
            {
              "number": 3,
              "text": "Talk to Hicklen at the southern outpost",
              "target": {
                "kind": "npc",
                "label": "Hicklen",
                "coordinates": [3452, 3847],
                "markers": "*"
              },
              "dialogue": "Hello! I assume my friend sent you, why don't you try killing some monsters for me? Press \"Q\" to toggle attack and click on a monster, or, press ta",
              "dialogue_truncated": true
            }
          ]
        },
        {
          "number": 3,
          "label": "Hicklen's hunt",
          "unlocks_after": "Talk to Hicklen",
          "objectives": [
            {
              "number": 4,
              "text": "Kill Spiders for Hicklen",
              "quantity": 15,
              "target": {
                "kind": "monster",
                "label": "Spider",
                "entity": {
                  "type": "monster",
                  "id": 89,
                  "name": "Spider"
                }
              }
            },
            {
              "number": 5,
              "text": "Kill Bats for Hicklen",
              "quantity": 5,
              "target": {
                "kind": "monster",
                "label": "Bat",
                "entity": {
                  "type": "monster",
                  "id": 124,
                  "name": "Bat"
                }
              }
            }
          ]
        },
        {
          "number": 4,
          "label": "Respawn lesson",
          "unlocks_after": "Complete objectives 4 and 5",
          "objectives": [
            {
              "number": 6,
              "text": "Return to Hicklen",
              "target": {
                "kind": "npc",
                "label": "Hicklen",
                "coordinates": [3452, 3847],
                "markers": "*"
              },
              "dialogue": "Welcome back! Do you see that purple portal below me? Please go to it and left click it to set your respawn when you die!"
            }
          ]
        },
        {
          "number": 5,
          "label": "Set the spawn gate",
          "unlocks_after": "Return to Hicklen",
          "objectives": [
            {
              "number": 7,
              "text": "Left click the spawn gate",
              "target": {
                "kind": "location",
                "label": "Spawn Gate",
                "coordinates": [3447, 3863]
              },
              "notes": [
                "Observed behavior: walking near the spawn gate completes the objective; left clicking was not required."
              ]
            }
          ]
        },
        {
          "number": 6,
          "label": "Return to town",
          "unlocks_after": "Set the spawn gate",
          "objectives": [
            {
              "number": 8,
              "text": "Return to Town Guide",
              "target": {
                "kind": "npc",
                "label": "Town Guide",
                "coordinates": [3415, 3722],
                "markers": "!?*"
              },
              "dialogue": "Did Hicklen treat you well? Hopefully this helped guide you somewhat in this world!"
            }
          ]
        }
      ],
      "turn_in": {
        "name": "Town Guide",
        "coordinates": [3415, 3722],
        "markers": "!?*",
        "dialogue": "Please see my friend when you want to leave Silvest!"
      },
      "rewards": {
        "guaranteed": [
          {
            "type": "experience",
            "amount": 500,
            "label": "Experience"
          }
        ],
        "choose_one": []
      },
      "notes": []
    },
    {
      "id": "leave-silvest",
      "name": "Leave Silvest",
      "category": "Tutorial",
      "region": "Silvest",
      "area": "Silvest Town - Bank",
      "min_level": 1,
      "repeatable": false,
      "giver": {
        "name": "Brother John",
        "coordinates": [3464, 3729],
        "markers": "!"
      },
      "prerequisites": [],
      "initial_dialogue": "Hey there, are you wanting to leave Silvest? My friend, Jed at the docks can guide you. The docks are to the north.",
      "stages": [
        {
          "number": 1,
          "label": "Find passage",
          "objectives": [
            {
              "number": 1,
              "text": "Speak to Priest Jed at the Docks",
              "target": {
                "kind": "npc",
                "label": "Priest Jed",
                "coordinates": [3657, 3612],
                "markers": "*"
              },
              "dialogue": "Did Brother John send you? If you're looking to leave Silvest, you can have my ticket to go on the boat! *he hands you his ticket* Go see Brother",
              "dialogue_truncated": true
            }
          ]
        },
        {
          "number": 2,
          "label": "Sail to Jeel",
          "unlocks_after": "Speak to Priest Jed",
          "objectives": [
            {
              "number": 2,
              "text": "Get on the boat",
              "target": {
                "kind": "location",
                "label": "Boat to Jeel",
                "coordinates": [3678, 3570]
              },
              "notes": [
                "Left click the boat to travel to Jeel, then speak to Brother Tom."
              ]
            }
          ]
        }
      ],
      "turn_in": {
        "name": "Brother Tom",
        "area": "Jeel",
        "coordinates": [3829, 3272],
        "markers": "?",
        "dialogue": "Hey there traveler, welcome to Jeel! This land is called Krythan, I hope you enjoy your adventures here!"
      },
      "rewards": {
        "guaranteed": [
          {
            "type": "experience",
            "amount": 500,
            "label": "Experience"
          }
        ],
        "choose_one": []
      },
      "notes": []
    },
